# Hosts of the test bench. Copy this file to .env and fill in your own values.
# .env stays out of git, so no address of your network lands in the repository.
#
#   cp .env.example .env && ${EDITOR:-nano} .env
#
# Every script in this repository reads .env from the repository root.

# --- The GPU host that serves the judge model and the llama.cpp fork ---
# The SSH target: an alias from ~/.ssh/config, or user@host.
LEGION_SSH=gpu-host
# The address that another host uses to reach it.
LEGION_IP=10.0.0.10
# The folder with the GGUF files on that host.
MODELS_DIR=/opt/models
# The stock llama.cpp build, and the PrismML fork.
LLAMA_DIR=/opt/llama.cpp
LLAMA_PRISM_DIR=/opt/llama.cpp-prism

# --- The second model host, with the 27B chat model ---
GAMING_IP=10.0.0.11

# --- The container host with the router and the judges ---
POC_SSH=root@10.0.0.20
POC_IP=10.0.0.20
# The folder on that host that holds the copied code.
POC_DIR=/opt/jev-poc-src

# --- The build host with Podman ---
BUILDBOX_SSH=root@10.0.0.30
BUILDBOX_DIR=/srv/semif-test

# --- The Proxmox node, for provision-hosts.sh ---
PVE_SSH=pve-node
PVE_STORAGE=pve-zfs
PVE_TEMPLATE=local:vztmpl/debian-13-standard_13.6-1_amd64.tar.zst
POC_VMID=110
POC_CIDR=10.0.0.20/24
POC_GATEWAY=10.0.0.1
POC_DNS=10.0.0.2

# --- The gateway with the model tiers ---
LITELLM_URL=http://10.0.0.40:4000

# --- Keys. The source is gopass, never a file in this repository. ---
# The cloud model of the router reads this one.
OPENCODE_GO_API_KEY=
# Optional. The upstream router asks Jev for the decision when this is set.
TYPESAFE_API_KEY=
# The sudo password of the GPU host. The security test needs it for strace and tcpdump.
# It normally lives in ~/.env, and the scripts read that file too.
HOMELAB_PEPPE_SUDO_PASSWORD=

# --- The PII proxy test (pii-proxy/) ---
# The container host next to LiteLLM. It runs the 2 Presidio containers.
LITELLM_SSH=root@10.0.0.40
LITELLM_HOST_IP=10.0.0.40
# The 2 Presidio endpoints.
PRESIDIO_ANALYZER_URL=http://10.0.0.40:5002
PRESIDIO_ANONYMIZER_URL=http://10.0.0.40:5001
# The llama.cpp fork with /v1/decision. It is the second gate.
DECISION_FORK_URL=http://10.0.0.10:11436

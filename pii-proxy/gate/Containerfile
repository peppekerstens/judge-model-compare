# The PII gate. It holds no model, so it needs no GPU and about 120 MB.
FROM python:3.13-slim

RUN pip install --no-cache-dir "fastapi==0.115.6" "uvicorn[standard]==0.34.0" "httpx==0.28.1"

WORKDIR /app
COPY gate.py /app/gate.py
COPY gate/app.py /app/app.py

ENV LOG_DB=/data/pii-gate.sqlite
VOLUME /data
EXPOSE 8086

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8086"]

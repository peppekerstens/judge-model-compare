# The compose file in this folder reads this file as .env. Copy it and fill it in.
# poc/.env is in .gitignore. The values match the ones in ../.env.

# The judge model, served by llama-server on the GPU host.
SEMIF_LLAMA_URL=http://10.0.0.10:11434
# The chat models of the router, served on the second model host.
GAMING_URL=http://10.0.0.11:11434
# The llama.cpp fork with /v1/decision, for the test judge.
DECISION_URL=http://10.0.0.10:11436

# The cloud model of the router. gopass is the source of this key.
OPENCODE_GO_API_KEY=

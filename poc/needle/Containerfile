# Needle 3 for the bench, on the CPU of the model host. It needs no GPU.
# Build:  podman build -t needle-smoke .
# Run:    podman run --rm -v $PWD:/app -v ~/needle-cache:/root/.cache needle-smoke \
#           python /app/needle_bench.py --cases /app/judge_cases.jsonl --out /app/out --mode tools
#
# Pin 3.0.1. Version 3.0.5 asks Hugging Face for an engine wheel 3.0.2, and that file
# does not exist. The model repository holds 3.0.0 and 3.0.1 only.
FROM docker.io/library/python:3.13-slim
RUN pip install --no-cache-dir "cactus-needle==3.0.1"
ENV NEEDLE_TELEMETRY=0 DO_NOT_TRACK=1 PYTHONUNBUFFERED=1
WORKDIR /app

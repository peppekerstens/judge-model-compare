# Provider key. Either an OpenRouter key, or keys for any LiteLLM provider.
OPENROUTER_API_KEY=

# Optional. When set, Jev makes the routing decision. Without it the router
# uses the cheapest-eligible baseline and no request data leaves the process.
TYPESAFE_API_KEY=

# Must match general_settings.master_key in config.yaml.
LITELLM_MASTER_KEY=sk-jev-router

# Optional. Path to the routing policy file (default: ./router.yaml).
JEV_ROUTER_CONFIG=router.yaml
